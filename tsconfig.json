{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "alwaysStrict": true,
    "declaration": true,
    "declarationMap": false,
    "declarationDir": "./dist/types",
    "disableSizeLimit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // "importsNotUsedAsValues": "error",
    "inlineSourceMap": false,
    "inlineSources": false,
    // "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "woby",
    "lib": [
      "dom",
      "esnext",
      "WebWorker"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "newLine": "lf",
    "noEmitOnError": false,
    "noImplicitThis": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "rootDir": "src",
    "outDir": "dist",
    "pretty": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "target": "es2020",
    "useDefineForClassFields": false,
    "useUnknownInCatchVariables": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    // `@woby/styled`'s package.json points "types" at ./dist/types/index.d.ts, but its build emits
    // to ./dist/types/src/index.d.ts, so the declarations are unreachable through normal resolution
    // and `tw` would fall back to `any` (TS7016 under noImplicitAny). Map it explicitly until the
    // dependency's own "types" field is corrected.
    "paths": {
      "@woby/styled": [
        "./node_modules/@woby/styled/dist/types/src/index.d.ts"
      ]
    }
    // "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    // "composite": true,
  },
  // // HIGHLIGHT: exclude tests and non-sources
  // "exclude": [
  //     "node_modules",
  //     "tailwind.*.*",
  //     "vite.*.*ts",
  //     "dist*",
  //     "docs",
  //     "**/*.test.ts",
  //     "**/*.test.tsx"
  // ],
  "exclude": [
    "node_modules",
    "tailwind.*.*",
    "vite.*.*ts",
    "dist*",
    "docs",
    "test/**/*",
    "src/ssr/**/*",
    "src/test.ts",
    "src/app.tsx",
    "src/main.ts",
    "index.test.ts"
  ],
  "include": [
    "src/**/*",
    "index.test.ts"
  ]
}